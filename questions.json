<script>
    let questions = [];
    let currentIndex = 0;
    let score = 0;
    let timer = null;
    let timeLeft = 0;
    let userAnswers = [];

    // Load questions from local questions.json
    async function loadQuestions() {
      try {
        const res = await fetch('questions.json');
        const rawData = await res.json();
        
        // Normalize JSON: Extract option_0..3 into an array and adjust answerIndex
        questions = rawData.map(q => {
          const options = [];
          if (q.option_0 !== undefined) options.push(q.option_0);
          if (q.option_1 !== undefined) options.push(q.option_1);
          if (q.option_2 !== undefined) options.push(q.option_2);
          if (q.option_3 !== undefined) options.push(q.option_3);

          // If answerIndex is 1-based (1, 2, 3, 4), convert to 0-based index (0, 1, 2, 3)
          let correctIdx = typeof q.answerIndex === 'number' ? q.answerIndex - 1 : 0;
          if (correctIdx < 0) correctIdx = 0;

          return {
            id: q.id,
            question: q.question,
            options: options.length > 0 ? options : (q.options || []),
            answerIndex: correctIdx,
            timeLimitSeconds: q.timeLimitSeconds || 60,
            explanation: q.explanation || ''
          };
        });

      } catch (e) {
        console.error("Could not load questions.json", e);
      }
    }

    document.getElementById('start-btn').addEventListener('click', () => {
      if (!questions.length) {
        alert("Questions are still loading or could not be found.");
        return;
      }
      document.getElementById('start-screen').classList.add('hidden');
      document.getElementById('quiz-screen').classList.remove('hidden');
      currentIndex = 0;
      score = 0;
      userAnswers = [];
      showQuestion();
    });

    function showQuestion() {
      clearInterval(timer);
      const q = questions[currentIndex];
      timeLeft = q.timeLimitSeconds;
      
      document.getElementById('question-progress').textContent = `Question ${currentIndex + 1} of ${questions.length}`;
      document.getElementById('timer-count').textContent = timeLeft;
      document.getElementById('question-text').textContent = q.question;
      
      const optContainer = document.getElementById('options-container');
      optContainer.innerHTML = '';
      document.getElementById('next-btn').classList.add('hidden');

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'opt-btn';
        btn.textContent = opt;
        btn.onclick = () => selectAnswer(idx);
        optContainer.appendChild(btn);
      });

      timer = setInterval(() => {
        timeLeft--;
        document.getElementById('timer-count').textContent = timeLeft;
        if (timeLeft <= 0) {
          clearInterval(timer);
          selectAnswer(-1); // Timeout
        }
      }, 1000);
    }

    function selectAnswer(selectedIndex) {
      clearInterval(timer);
      const q = questions[currentIndex];
      const isCorrect = selectedIndex === q.answerIndex;
      if (isCorrect) score++;

      userAnswers.push({
        question: q.question,
        options: q.options,
        selected: selectedIndex,
        correct: q.answerIndex,
        explanation: q.explanation
      });

      const buttons = document.querySelectorAll('.opt-btn');
      buttons.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === q.answerIndex) btn.classList.add('correct');
        if (idx === selectedIndex && !isCorrect) btn.classList.add('wrong');
      });

      const nextBtn = document.getElementById('next-btn');
      nextBtn.classList.remove('hidden');
      nextBtn.onclick = () => {
        currentIndex++;
        if (currentIndex < questions.length) {
          showQuestion();
        } else {
          showResults();
        }
      };
    }

    function showResults() {
      document.getElementById('quiz-screen').classList.add('hidden');
      document.getElementById('result-screen').classList.remove('hidden');
      document.getElementById('score-display').textContent = `You scored ${score} out of ${questions.length} (${Math.round((score / questions.length) * 100)}%)`;

      const reviewContainer = document.getElementById('review-container');
      reviewContainer.innerHTML = '<h4>Answer Explanations:</h4>';
      userAnswers.forEach((ans, i) => {
        const div = document.createElement('div');
        div.className = 'review-card';
        div.innerHTML = `
          <p><strong>Q${i+1}: ${ans.question}</strong></p>
          <p>Your answer: ${ans.selected >= 0 ? ans.options[ans.selected] : 'Timed Out'} | Correct: <strong>${ans.options[ans.correct]}</strong></p>
          <p class="explanation">💡 <em>${ans.explanation}</em></p>
        `;
        reviewContainer.appendChild(div);
      });
    }

    document.getElementById('restart-btn').addEventListener('click', () => {
      document.getElementById('result-screen').classList.add('hidden');
      document.getElementById('start-screen').classList.remove('hidden');
    });

    loadQuestions();
  </script>
